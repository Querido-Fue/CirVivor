{
    "name": "lonely_tower",
    "version": "0.4",
    "main": "game/index.html",
    "scripts": {
        "build:wasm:flow-field": "node game/test/support/build_enemy_ai_flow_field_wasm.mjs",
        "check:wasm:flow-field": "node game/test/support/build_enemy_ai_flow_field_wasm.mjs --check",
        "test:wasm:flow-field:stress": "node --experimental-vm-modules game/test/stress/enemy_ai_flow_field_stress.mjs",
        "benchmark:wasm:flow-field": "node game/test/benchmark/enemy_ai_flow_field_wasm.bench.mjs",
        "test": "node --experimental-vm-modules --test game/test/*.test.mjs"
    },
    "js-flags": "",
    "window": {
        "title": "Lonely Tower",
        "toolbar": false,
        "fullscreen": false,
        "position": "center",
        "min_width": 1280,
        "min_height": 720,
        "icon": "game/image/logo.png"
    },
    "devDependencies": {
        "wabt": "1.0.39"
    }
}
