{
    "name": "lonely_tower",
    "version": "0.4",
    "main": "game/index.html",
    "scripts": {
        "build:wasm:flow-field": "node game/test/support/build_enemy_ai_flow_field_wasm.mjs",
        "check:wasm:flow-field": "node game/test/support/build_enemy_ai_flow_field_wasm.mjs --check",
        "build:wasm:collision-contact": "node game/test/support/build_collision_contact_wasm.mjs",
        "check:wasm:collision-contact": "node game/test/support/build_collision_contact_wasm.mjs --check",
        "benchmark:wasm:collision-contact": "node --experimental-vm-modules game/test/benchmark/collision_hexa_contact_boolean.bench.mjs",
        "test:wasm:flow-field:stress": "node --experimental-vm-modules game/test/stress/enemy_ai_flow_field_stress.mjs",
        "benchmark:wasm:flow-field": "node game/test/benchmark/enemy_ai_flow_field_wasm.bench.mjs",
        "test:render:golden": "node game/test/support/run_nw_render_pipeline_golden.mjs --check",
        "update:render:golden": "node game/test/support/run_nw_render_pipeline_golden.mjs --update",
        "test:webgpu:capability": "node game/test/support/run_nw_webgpu_capability.mjs",
        "test:webgpu:r3-enemy-word": "node game/test/support/run_nw_r3_enemy_word.mjs",
        "test:webgpu:r4-tower-group": "node game/test/support/run_nw_r4_tower_group.mjs",
        "test:webgpu:r5-actor-verbs": "node game/test/support/run_nw_r5_actor_verbs.mjs",
        "test:webgpu:r6-tower-merge": "node game/test/support/run_nw_r6_tower_merge.mjs",
        "test:webgpu:r7-actor-payload-multiplicity": "node game/test/support/run_nw_r7_actor_payload_multiplicity.mjs",
        "test:webgpu:r8-shop-editor": "node game/test/support/run_nw_r8_shop_editor.mjs",
        "test:webgpu:r9-overtime-pressure": "node game/test/support/run_nw_r9_overtime_pressure.mjs",
        "test:webgpu:r9-multi-wave": "node game/test/support/run_nw_r9_multi_wave.mjs",
        "test:webgpu:post-r5-live": "node game/test/support/run_nw_post_r5_live_bugfix.mjs",
        "test:title-gpu:smoke": "node game/test/support/run_nw_title_gpu_pipeline.mjs --profile smoke",
        "test:title-gpu:qa": "node game/test/support/run_nw_title_gpu_pipeline.mjs --profile qa --keep-run-directory",
        "benchmark:title-gpu": "node game/test/support/run_nw_title_gpu_pipeline.mjs --profile full",
        "test": "node --experimental-vm-modules --test game/test/*.test.mjs"
    },
    "js-flags": "",
    "window": {
        "title": "Lonely Tower",
        "toolbar": false,
        "fullscreen": false,
        "position": "center",
        "min_width": 1280,
        "min_height": 720,
        "icon": "game/image/logo.png"
    },
    "devDependencies": {
        "wabt": "1.0.39"
    }
}
