{
    "schemaVersion": 1,
    "suiteId": "title-overlay-parity-v1",
    "oracle": {
        "runtime": "nwjs",
        "entryPoint": "game/index.html",
        "viewport": {
            "width": 1280,
            "height": 720,
            "devicePixelRatio": 1
        },
        "clock": {
            "fixedStepHz": 60,
            "frameDurationMs": 16.666666666666668,
            "timeOriginMs": 123456,
            "titleReadyFrame": 420,
            "overlayOpenCompleteFrames": 30
        },
        "random": {
            "algorithm": "xorshift32",
            "seed": 1817,
            "patchTarget": "Math.random"
        },
        "pointer": {
            "x": 16,
            "y": 16,
            "buttons": []
        },
        "settings": {
            "windowMode": "windowed",
            "widescreenSupport": true,
            "width": 1280,
            "height": 720,
            "renderScale": 100,
            "uiScale": 100,
            "disableTransparency": false,
            "language": "korean",
            "theme": "dark",
            "tooltipDelaySeconds": 0.3,
            "bgmVolume": 0,
            "sfxVolume": 0,
            "debugMode": false
        }
    },
    "capture": {
        "staticSurfaceRoles": [
            "background",
            "object",
            "effect",
            "texteffect",
            "ui",
            "vignette",
            "top"
        ],
        "dynamicSurfacePolicy": "all-in-sort-order",
        "includeFinalComposite": true
    },
    "coverage": {
        "titleOverlayFactory": [
            {
                "key": "mapSelect",
                "controllerClass": "MapSelectOverlay",
                "trigger": {
                    "group": "card",
                    "entryId": "start"
                }
            },
            {
                "key": "deck",
                "controllerClass": "DeckOverlay",
                "trigger": {
                    "group": "card",
                    "entryId": "deck"
                }
            },
            {
                "key": "setting",
                "controllerClass": "SettingsOverlay",
                "trigger": {
                    "group": "secondary",
                    "entryId": "setting"
                }
            },
            {
                "key": "credits",
                "controllerClass": "CreditsOverlay",
                "trigger": {
                    "group": "secondary",
                    "entryId": "credits"
                }
            },
            {
                "key": "quickStart",
                "controllerClass": "QuickStartOverlay",
                "trigger": {
                    "group": "card",
                    "entryId": "quick_start"
                }
            },
            {
                "key": "records",
                "controllerClass": "RecordsOverlay",
                "trigger": {
                    "group": "card",
                    "entryId": "records"
                }
            },
            {
                "key": "research",
                "controllerClass": "ResearchOverlay",
                "trigger": {
                    "group": "card",
                    "entryId": "research"
                }
            },
            {
                "key": "achievements",
                "controllerClass": "AchievementsOverlay",
                "trigger": {
                    "group": "secondary",
                    "entryId": "achievements"
                }
            }
        ],
        "managerOverlays": [
            {
                "managerMethod": "openDebugOverlay",
                "managerKey": "debugPanel",
                "controllerClass": "DebugOverlay",
                "activation": "three-middle-clicks"
            },
            {
                "managerMethod": "openExitOverlay",
                "managerKey": "exitConfirm",
                "controllerClass": "ExitOverlay",
                "activation": "title-secondary-exit"
            },
            {
                "managerMethod": "openExternalLinkWarningOverlay",
                "managerKey": "externalLinkWarning",
                "controllerClass": "ExternalLinkWarningOverlay",
                "activation": "external-url-request"
            }
        ]
    },
    "inventory": {
        "orphanOverlayImplementations": [
            {
                "controllerClass": "CollectionOverlay",
                "sourcePath": "game/script/module/overlay/title/_collection.js",
                "productionEntryPoint": null
            }
        ]
    },
    "exclusions": {
        "visualScenarios": [
            {
                "controllerClass": "CollectionOverlay",
                "reason": "no-production-entry-point"
            }
        ]
    },
